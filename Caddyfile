{
	admin off
	frankenphp
}

{$SERVER_NAME:addons.neverball.org} {
	root * /app/public
	encode gzip zstd

	request_body {
		max_size 25MB
	}

	# Route Gotify WebSocket and API requests to internal container via configurable path
	handle_path /{$GOTIFY_PATH:gotify}* {
		reverse_proxy gotify:80
	}

	# Allow public downloads of uploaded ZIP files from /app/storage/uploads/
	handle /storage/uploads/*.zip {
		root * /app
		file_server
	}

	# Deny access to storage internals (tokens, hashes, rate-limit files)
	@storage_blocked {
		path /storage/*
		not path /storage/uploads/*.zip
	}
	respond @storage_blocked "Forbidden" 403

	# Deny access to hidden dotfiles
	@dotfiles path */.*
	error @dotfiles 404

	# Serve static files directly if they exist on disk
	file_server

	php_server {
		try_files {path} index.php
	}
}
