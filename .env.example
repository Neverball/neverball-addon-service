# Domain / base URL
SERVER_NAME=addons.neverball.org
BASE_URL=https://addons.neverball.org

# Space-separated origins allowed to embed this service in an <iframe>
FRAME_ANCESTORS="https://neverball.org https://*.neverball.org"

# Optional comma-separated extra Origins allowed on POST (BASE_URL is always allowed)
ALLOWED_ORIGINS=

# Optional static HMAC secret for stateless CSRF tokens (auto-generated in storage/csrf.key if empty)
CSRF_SECRET=

# Host port mappings (change for local testing, e.g. HTTP_PORT=8080)
HTTP_PORT=80
HTTPS_PORT=443

# Set to "development" to enable Vite dev server integration
APP_ENV=production

# Gotify push notification server (optional; defaults to internal container http://gotify:80)
GOTIFY_URL=http://gotify:80
GOTIFY_TOKEN=
# Public URL subpath for Gotify (change to an unguessable string for extra security, e.g. GOTIFY_PATH=my-secret-gotify-path)
GOTIFY_PATH=gotify

# Target GitHub repository for dispatching addon PR creation workflows
GITHUB_PACKAGES_REPO=Neverball/packages

# Personal Access Token (PAT) with repo scope for GitHub repository_dispatch events
GITHUB_DISPATCH_TOKEN=
