# Domain / base URL
SERVER_NAME=addons.neverball.org
BASE_URL=https://addons.neverball.org

# Host port mappings (change for local testing, e.g. HTTP_PORT=8080)
HTTP_PORT=80
HTTPS_PORT=443

# Set to "development" to enable Vite dev server integration
APP_ENV=production

# Email address to notify about new addon submissions
NOTIFY_EMAIL=admin@example.com

# From address used when sending notification emails
NOTIFY_FROM=neverball-noreply@snth.net

# Target GitHub repository for dispatching addon PR creation workflows
GITHUB_PACKAGES_REPO=Neverball/packages

# Personal Access Token (PAT) with repo scope for GitHub repository_dispatch events
GITHUB_DISPATCH_TOKEN=
